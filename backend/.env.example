# Copy to .env in this directory and configure the serial port connected to your Arduino.
SERIAL_PORT=
SERIAL_BAUD=9600
READING_STALE_MS=10000
DEMO_MODE=false
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Optional: enables the backend-only AI assistant. Never put this key in frontend variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
